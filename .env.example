LLM_CACHE_DSN=postgresql://llmcache:llmcache@localhost:5432/llmcache
LLM_CACHE_TABLE=llm_cache
LLM_CACHE_NAMESPACE=default

# Must match the embedding model in use — pgvector fixes the vector width at
# the column, so changing this means recreating the table.
LLM_CACHE_EMBEDDING_DIMENSIONS=1536

# Minimum cosine similarity for a semantic hit.
LLM_CACHE_SIMILARITY_THRESHOLD=0.95
LLM_CACHE_SEARCH_LIMIT=5
LLM_CACHE_TTL_SECONDS=

OPENAI_API_KEY=sk-...
